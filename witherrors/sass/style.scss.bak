body {
  font-family: sans-serif;
  margin: 0;
  background-color: #1a1a1a;
  color: #e0e0e0;
}

.nav {
  background-color: #242424;
  border-bottom: 1px solid #333;

  .container {
    display: flex;
    gap: 2rem;
    padding: 1rem 0;
  }

  a {
    color: #e0e0e0;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.15s ease;

    &:hover {
      color: #ffffff;
      text-decoration: underline;
    }

    &.active {
      color: #ffffff;
      border-bottom: 2px solid #ffffff;
      padding-bottom: 2px;
    }
  }
}

.section {
  padding: 2rem 0;
}

.container {
  max-width: 800px;
  margin: 0 auto;
  padding: 0 1rem;
}